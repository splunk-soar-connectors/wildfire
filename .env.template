# Copy this file to .env and fill in local values. Never commit the populated
# .env file or paste its contents into logs, prompts, or documentation.

# Required for credential-backed WildFire tests and temporary probes
WILDFIRE_BASE_URL=https://wildfire.paloaltonetworks.com
WILDFIRE_API_KEY=
WILDFIRE_VERIFY_SERVER_CERT=true

# Optional timeout for temporary probe scripts
WILDFIRE_TIMEOUT_SECONDS=30

# Optional defaults for temporary probe scripts
WILDFIRE_TEST_FILE_SHA256=
WILDFIRE_TEST_PCAP_PLATFORM=
